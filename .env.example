# ==================== Free AI APIs (Zero Cost) ====================
# Option 1: Built-in Free AI Engine (Default - NO KEY NEEDED!)
# Option 2: Pollinations.ai Free Image Generator (NO KEY NEEDED!)

# Option 3: Google Gemini API (100% Free Tier - No credit card required!)
# Get free key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option 4: OpenRouter Free Models (Llama 3 / Gemma 2)
# Get free key here: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Option 5: HuggingFace Token (Free tier for Stable Diffusion XL)
# Get token here: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Option 6: Anthropic Claude (Optional)
ANTHROPIC_API_KEY=

# ==================== Database & Cache (Optional Fallback) ====================
# If omitted or unavailable, app automatically uses zero-setup In-Memory DB & Queue!
DATABASE_URL=
REDIS_URL=

# ==================== Server Settings ====================
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
